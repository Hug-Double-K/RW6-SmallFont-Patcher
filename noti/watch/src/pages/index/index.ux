<template>
  <div class="main">
    <!-- 도착 화면: 폰이 보낸 알림만 바로 보여줌 (목록·빈 화면을 먼저 보여주지 않음) -->
    <div if="{{ mode === 'arrive' }}" class="arrive">
      <scroll style="flex-direction: column; width: 100%; flex: 1" scroll-y="{{ true }}">
        <image if="{{ cur.img }}" src="{{ cur.img }}" style="width: 100%; margin-top: 28px" />
        <div if="{{ !cur.img }}" class="tview">
          <div class="t-row">
            <image if="{{ cur.icon }}" src="{{ cur.icon }}" class="t-icon" />
            <text class="t-app">{{ cur.app }}</text>
          </div>
          <text class="t-snd" style="font-size: {{ alert.fs || 26 }}px">{{ cur.sender }}</text>
          <text for="(i, p) in cur.parts" style="width: 100%; font-size: {{ alert.fs || 26 }}px; color: #eeeeee; margin-top: 4px">{{ p }}</text>
          <text if="{{ cur.pending }}" class="t-app" style="margin-top: 10px">사진 받는 중…</text>
        </div>
      </scroll>
      <text class="btn off" @click="arriveOff">끄기</text>
    </div>

    <!-- 목록: 직접 열었을 때 -->
    <div if="{{ mode === 'list' }}" class="arrive">
      <div class="head">
        <div class="head-hit" @click="deleteToggle">
          <text class="head-pill {{ notis ? 'head-pill-on' : '' }}">{{ notis ? (deleteOn ? "X" : "-") : "" }}</text>
        </div>
        <text class="head-title" @click="scrollToTop">알림 {{ notis }}</text>
        <div class="head-hit"></div>
      </div>
      <scroll id="list" style="flex-direction: column; width: 100%; flex: 1" scroll-y="{{ true }}">
        <text class="btn danger" if="{{ deleteOn && notis }}" @click="deleteAll">모두 지우기</text>
        <text class="empty" if="{{ loaded && !notis }}">수신된 알림이 없습니다.</text>
        <div class="card" for="(i, li) in list">
          <text class="btn danger" if="{{ deleteOn }}" @click="deleteOne(li, i)">지우기</text>
          <image if="{{ li.kind === 'img' }}" src="{{ li.uri }}" style="width: 100%" @click="openPopup(li)" />
          <div if="{{ li.kind === 'text' }}" class="tcard" @click="openPopup(li)">
            <div class="t-row">
              <image if="{{ li.icon }}" src="{{ li.icon }}" class="t-icon" />
              <text class="t-app">{{ li.a || '알림' }}</text>
            </div>
            <text class="t-snd">{{ li.s }}</text>
            <text class="t-body">{{ li.b }}</text>
          </div>
        </div>
        <text if="{{ status }}" style="font-size: 20px; color: #888888; margin-top: 10px">{{ status }}</text>
      </scroll>
    </div>
  </div>
</template>

<script>
import app from '@system.app'
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import router from '@system.router'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'

const DIR = 'internal://mass/rw6noti'
const ICONS = 'internal://mass/rw6noti_icons'
const MAX_SAVE = 40
// 앱을 연 뒤 이 시간 안에 폰에서 알림이 오면 목록 없이 그 알림만 보여줌
const WAIT_MS = 2500
let conn = null
let waitTimer = null
const receiving = {}
const done = {} // 이미 처리한 것 (폰이 같은 글을 여러 번 보내므로)

// 빠른 Base64 해독
const LOOK = new Uint8Array(128)
'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'.split('').forEach((c, i) => { LOOK[c.charCodeAt(0)] = i })

function split(body) {
  const out = []
  let cur = ''
  body.split('\n').forEach((line) => {
    while (line.length > 300) { if (cur) { out.push(cur); cur = '' } out.push(line.substr(0, 300)); line = line.substr(300) }
    if (cur && cur.length + line.length + 1 > 300) { out.push(cur); cur = line } else cur = cur ? `${cur}\n${line}` : line
  })
  if (cur) out.push(cur)
  return out
}

export default {
  private: {
    mode: 'wait', // wait(검은 화면) → arrive(알림) / list(목록)
    cur: { name: '', img: '', icon: '', app: '', sender: '', parts: [], pending: false },
    list: [],
    notis: 0,
    loaded: false,
    deleteOn: false,
    status: '',
    alert: { vibe: false, wake: false, fs: 26 },
  },

  onInit() {
    const self = this
    storage.get({ key: 'alert', success(v) { try { if (v) self.alert = JSON.parse(v) } catch (e) {} } })
    conn = interconnect.instance()
    conn.onmessage = (msg) => { self.onMsg(msg.data) }
    self.ready()
    // 폰이 연 게 아니라 직접 열었으면 잠시 뒤 목록
    waitTimer = setTimeout(() => { if (self.mode === 'wait') self.showList() }, WAIT_MS)
  },

  onShow() {
    this.ready()
    if (this.mode === 'list') this.refreshList()
  },

  // 도착 화면에서 뒤로(스와이프) = 목록으로
  onBackPress() {
    if (this.mode === 'arrive') { this.showList(); return true }
    return false
  },

  // 폰에 "이 알림 받았어" → 폰이 더 보내지 않음
  ack(name) {
    try { if (conn) conn.send({ data: { ack: name } }) } catch (e) {}
  },

  ready() {
    try { if (conn) conn.send({ data: { ready: 1 } }) } catch (e) {}
  },

  onMsg(d) {
    const self = this
    try {
      const k = d.substr(0, 1)
      if (k === 'S') {
        self.alert = { vibe: d.substr(1, 1) === '1', wake: d.substr(2, 1) === '1', fs: Number(d.substr(3, 2)) || 26 }
        storage.set({ key: 'alert', value: JSON.stringify(self.alert) })
        return
      }
      if (k === 'Q') { self.ready(); return }
      // 순번(2) + 구분(1) + 이름(13) + 데이터.  구분: D/E 글, f/g JPEG, d/e PNG (소문자 d·f = 중간 조각)
      const flag = d.substr(2, 1)
      const kind = (flag === 'D' || flag === 'E') ? 'json' : (flag === 'f' || flag === 'g') ? 'jpg' : 'png'
      const isEnd = flag === 'E' || flag === 'g' || flag === 'e'
      const offset = Number(d.substr(0, 2))
      const name = d.substr(3, 13)
      const key = `${name}.${kind}`
      if (done[key]) { if (isEnd) self.ack(name); return } // 이미 받은 것 → 받았다고 다시 알려줌
      if (offset === 0 || !receiving[key]) receiving[key] = { data: '', next: 0 }
      const r = receiving[key]
      if (offset !== r.next) { delete receiving[key]; return } // 순서 어긋나면 버림 (폰이 다시 보냄)
      r.data += d.substr(16)
      r.next++
      if (!isEnd) return
      delete receiving[key]
      done[key] = true
      self.ack(name)
      if (kind === 'json') self.gotText(name, r.data)
      else self.gotImage(name, kind, r.data)
    } catch (e) {
      self.status = e + ''
    }
  },

  // 글: 받은 내용을 메모리에서 바로 그림 (파일은 뒤에서 저장)
  gotText(name, json) {
    const self = this
    const m = JSON.parse(json)
    if (m.k && m.i) {
      file.mkdir({ uri: ICONS, recursive: true, complete() { file.writeArrayBuffer({ uri: `${ICONS}/${m.k}.png`, buffer: self.decode(m.i) }) } })
      delete m.i
    }
    self.show({
      name, img: '', icon: m.k ? `${ICONS}/${m.k}.png` : '',
      app: m.c ? `${m.a} · ${m.c}` : (m.a || ''), sender: m.s || '', parts: split(m.b || ''), pending: !!m.p,
    })
    self.notifyArrival()
    file.writeText({ uri: `${DIR}/${name}.json`, text: JSON.stringify(m), complete() { self.trim() } })
  },

  // 사진: 저장 후 표시. 먼저 온 같은 이름의 글 알림은 지우고 사진으로 바꿈
  gotImage(name, ext, b64) {
    const self = this
    const uri = `${DIR}/${name}.${ext}`
    file.writeArrayBuffer({
      uri,
      buffer: self.decode(b64),
      success() {
        const hadText = done[`${name}.json`]
        try { file.delete({ uri: `${DIR}/${name}.json` }) } catch (e) {}
        if (self.mode !== 'list' || self.cur.name === name) self.show({ name, img: uri, icon: '', app: '', sender: '', parts: [], pending: false })
        if (!hadText) self.notifyArrival()
        if (self.mode === 'list') self.refreshList()
        self.trim()
      },
      fail(e, c) { self.status = `저장 실패: ${c || e}` },
    })
  },

  show(cur) {
    if (waitTimer) { clearTimeout(waitTimer); waitTimer = null }
    this.cur = cur
    this.mode = 'arrive'
  },

  showList() {
    if (waitTimer) { clearTimeout(waitTimer); waitTimer = null }
    this.mode = 'list'
    this.refreshList()
  },

  // 도착 화면의 '끄기' = 이 알림 지우고 앱 닫기
  arriveOff() {
    const n = this.cur.name
    ;['json', 'jpg', 'png'].forEach((e) => { try { file.delete({ uri: `${DIR}/${n}.${e}` }) } catch (x) {} })
    try { conn.send({ data: { del: 1 } }) } catch (x) {}
    app.terminate()
  },

  // 오래된 알림 정리
  trim() {
    file.list({
      uri: DIR,
      success(data) {
        const files = data.fileList.sort((a, b) => b.uri.localeCompare(a.uri))
        files.slice(MAX_SAVE).forEach((f) => { try { file.delete({ uri: f.uri }) } catch (e) {} })
      },
    })
  },

  refreshList() {
    const self = this
    file.list({
      uri: DIR,
      success(data) {
        const files = data.fileList.sort((a, b) => b.uri.localeCompare(a.uri))
        // 같은 이름의 사진이 있으면 글(먼저 보낸 알림)은 숨김
        const names = {}
        files.forEach((f) => { if (f.uri.indexOf('.json') < 0) names[f.uri.replace(/\.[a-z]+$/, '')] = true })
        const shown = files.filter((f) => !(f.uri.indexOf('.json') >= 0 && names[f.uri.replace(/\.json$/, '')]))
        Promise.all(shown.map((f) => new Promise((res) => {
          const item = { uri: f.uri, kind: f.uri.indexOf('.json') >= 0 ? 'text' : 'img', a: '', s: '', b: '', icon: '' }
          if (item.kind !== 'text') { res(item); return }
          file.readText({
            uri: f.uri,
            success(r) {
              try {
                const m = JSON.parse(r.text)
                item.a = m.c ? `${m.a} · ${m.c}` : (m.a || '')
                item.s = m.s || ''
                if (m.k) item.icon = `${ICONS}/${m.k}.png`
                const body = m.b || ''
                item.b = body.length > 120 ? body.substr(0, 120) + '…' : body
              } catch (e) { item.b = `(읽지 못함: ${e})` }
              res(item)
            },
            fail(d, c) { item.b = `(파일 읽기 실패 ${c || ''})`; res(item) },
          })
        }))).then((items) => {
          self.list = items
          self.notis = items.length
          self.loaded = true
          self.report()
        })
      },
      fail() { self.list = []; self.notis = 0; self.loaded = true; self.report() },
    })
  },

  scrollToTop() {
    const el = this.$element('list')
    if (el) el.scrollTo({ top: 0, behavior: 'smooth' })
  },

  deleteToggle() { if (this.notis) this.deleteOn = !this.deleteOn },

  // 남은 알림 개수를 폰에 알려줌 (워치 알림 목록의 'N건'에 사용)
  report() {
    try { if (conn) conn.send({ data: { n: this.notis } }) } catch (e) {}
  },

  deleteAll() {
    this.list.forEach((li) => this.removeFile(li))
    this.list = []
    this.notis = 0
    this.deleteOn = false
    this.report()
  },

  deleteOne(li, i) {
    this.removeFile(li)
    this.list.splice(i, 1)
    this.notis = this.list.length
    if (!this.notis) this.deleteOn = false
    this.report()
  },

  removeFile(li) {
    try { file.delete({ uri: li.uri }) } catch (e) {}
  },

  openPopup(li) {
    if (this.deleteOn) return
    router.push({ uri: '/pages/detail', params: { uri: li.uri, arrival: '0' } })
  },

  notifyArrival() {
    if (this.alert.wake) {
      try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) {}
      setTimeout(() => { try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {} }, 8000)
    }
    if (this.alert.vibe) {
      try { vibrator.vibrate({ mode: 'long' }) } catch (e) {}
    }
  },

  onDestroy() { app.terminate() },

  decode(b64) {
    let n = b64.length
    while (n > 0 && b64.charCodeAt(n - 1) === 61) n-- // '=' 제거
    const len = Math.floor((n * 3) / 4)
    const out = new Uint8Array(len)
    let j = 0
    for (let i = 0; i < n; i += 4) {
      const a = LOOK[b64.charCodeAt(i)], b = LOOK[b64.charCodeAt(i + 1)]
      const c = i + 2 < n ? LOOK[b64.charCodeAt(i + 2)] : 0, d = i + 3 < n ? LOOK[b64.charCodeAt(i + 3)] : 0
      out[j++] = (a << 2) | (b >> 4)
      if (j < len) out[j++] = ((b & 15) << 4) | (c >> 2)
      if (j < len) out[j++] = ((c & 3) << 6) | d
    }
    return out
  },
}
</script>

<style>
  @import '../../common/common.css';
  .arrive { width: 100%; flex: 1; flex-direction: column; align-items: center; }
  .tview { width: 100%; flex-direction: column; padding: 28px 24px 16px; }
</style>
