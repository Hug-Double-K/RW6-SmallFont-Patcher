<template>
  <div class="main">
    <div class="head">
      <div class="head-hit" @click="deleteToggle">
        <text class="head-pill {{ notis ? 'head-pill-on' : '' }}">{{ notis ? (deleteOn ? "X" : "-") : "" }}</text>
      </div>
      <text class="head-title" @click="scrollToTop">알림 {{ notis }}</text>
      <div class="head-hit"></div>
    </div>
    <scroll id="list" style="flex-direction: column; width: 100%; flex: 1" scroll-y="{{ true }}">
      <text class="btn danger" if="{{ deleteOn && notis }}" @click="deleteAll">모두 지우기</text>
      <text class="empty" if="{{ !notis }}">수신된 알림이 없습니다.</text>
      <div class="card" for="(i, li) in list">
        <text class="btn danger" if="{{ deleteOn }}" @click="deleteOne(li, i)">지우기</text>
        <image if="{{ li.kind === 'img' }}" src="{{ li.uri }}" style="width: 100%" @click="openPopup(li)" />
        <div if="{{ li.kind === 'text' }}" class="tcard" @click="openPopup(li)">
          <div class="t-row">
            <image if="{{ li.icon }}" src="{{ li.icon }}" class="t-icon" />
            <text class="t-app">{{ li.a || '알림' }}</text>
          </div>
          <text class="t-snd">{{ li.s }}</text>
          <text class="t-body">{{ li.b }}</text>
        </div>
      </div>
      <text if="{{ status }}" style="font-size: 20px; color: #888888; margin-top: 10px">{{ status }}</text>
    </scroll>
  </div>
</template>

<script>
import app from '@system.app'
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import router from '@system.router'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'

const DIR = 'internal://mass/rw6noti'
const ICONS = 'internal://mass/rw6noti_icons'
const DEFAULT_SETTING = '{"vibe":true,"doNotDisturb":false,"disturbFromT":"23","disturbFromM":"00","disturbToT":"07","disturbToM":"00","maxSave":40}'
let conn = null

export default {
  private: {
    list: [],
    notis: 0,
    deleteOn: false,
    status: '',
    receiving: {},
    setting: {},
    alert: { vibe: false, wake: false },
  },

  onShow() {
    const self = this
    self.refreshList()
    storage.get({
      key: 'notiSetting',
      success(v) { self.setting = JSON.parse(v || DEFAULT_SETTING) },
      fail() { self.setting = JSON.parse(DEFAULT_SETTING) },
    })

    storage.get({ key: 'alert', success(v) { try { if (v) self.alert = JSON.parse(v) } catch (e) {} } })
    conn = interconnect.instance()
    // 조각: 순번(2) + 구분(d/e)(1) + 파일명(13) + Base64 데이터
    conn.onmessage = async (msg) => {
      try {
        const d = msg.data
        // S + 진동(0/1) + 화면깨우기(0/1) : 폰 앱 설정
        if (d.substr(0, 1) === 'S') {
          self.alert = { vibe: d.substr(1, 1) === '1', wake: d.substr(2, 1) === '1', fs: Number(d.substr(3, 2)) || 26 }
          storage.set({ key: 'alert', value: JSON.stringify(self.alert) })
          return
        }
        // Q = 폰이 "켜져 있니?" 확인 → 바로 준비됨 응답
        if (d.substr(0, 1) === 'Q') { self.ready(); return }
        // 구분: d/e = PNG, f/g = JPEG, D/E = 글(JSON)
        const flag = d.substr(2, 1)
        const part = { offset: Number(d.substr(0, 2)), isEnd: flag === 'e' || flag === 'E' || flag === 'g',
          text: flag === 'D' || flag === 'E', jpg: flag === 'f' || flag === 'g', name: d.substr(3, 13) }
        // 첫 조각이 오면 새로 시작 (재전송 대비)
        if (part.offset === 0 || !self.receiving[part.name]) self.receiving[part.name] = { data: '', got: [] }
        const r = self.receiving[part.name]

        // 앞 조각이 도착할 때까지 기다림 (최대 100초)
        let wait = 0
        while (part.offset !== 0 && !r.got.includes(part.offset - 1)) {
          await new Promise((res) => setTimeout(res, 500))
          if (++wait > 60) { delete self.receiving[part.name]; return } // 30초 넘게 앞 조각이 없으면 버림 (폰이 다시 보냄)
        }
        r.data += d.substr(16)
        r.got.push(part.offset)

        if (part.isEnd) {
          const max = self.setting.maxSave || 40
          while (self.list.length >= max) self.deleteOne(self.list[self.list.length - 1], self.list.length - 1)
          const uri = `${DIR}/${part.name}.${part.text ? 'json' : part.jpg ? 'jpg' : 'png'}`
          if (part.text) self.saveIcon(r.data)
          const args = part.text ? { text: r.data } : { buffer: self.decode(r.data) }
          const write = (o) => (part.text ? file.writeText(o) : file.writeArrayBuffer(o))
          write(Object.assign(args, {
            uri,
            success() {
              // 폰 앱에서 고른 대로 진동 / 화면 깨우기, 그리고 새 알림을 바로 크게 띄움
              self.notifyArrival()
              router.push({ uri: '/pages/detail', params: { uri, arrival: '1' } })
            },
            fail(e) { self.status = `저장 실패: ${e}` },
            complete() { delete self.receiving[part.name]; self.refreshList() },
          }))
        }
      } catch (e) {
        self.status = e + ''
      }
    }
    // 앱이 떴으니 폰에 "준비됨" 알림 → 폰이 기다리지 않고 바로 보냄
    self.ready()
  },

  // 폰에 "받을 준비 됨"을 알림 (폰은 이걸 받자마자 보냄)
  ready() {
    try { if (conn) conn.send({ data: { ready: 1 } }) } catch (e) {}
  },

  // 글 알림에 들어 있는 앱 아이콘을 앱별로 한 번만 저장
  saveIcon(json) {
    const self = this
    try {
      const m = JSON.parse(json)
      if (!m.k || !m.i) return
      file.mkdir({ uri: ICONS, recursive: true, complete() {
        file.writeArrayBuffer({ uri: `${ICONS}/${m.k}.png`, buffer: self.decode(m.i) })
      } })
    } catch (e) {}
  },

  refreshList() {
    const self = this
    file.list({
      uri: DIR,
      success(data) {
        const files = data.fileList.sort((a, b) => b.uri.localeCompare(a.uri))
        // 글 알림은 내용을 먼저 다 읽은 뒤 목록을 한 번에 바꾼다 (나중에 채우면 화면에 반영이 안 됨)
        Promise.all(files.map((f) => new Promise((res) => {
          const item = { uri: f.uri, kind: f.uri.indexOf('.json') >= 0 ? 'text' : 'img', a: '', s: '', b: '', icon: '' }
          if (item.kind !== 'text') { res(item); return }
          file.readText({
            uri: f.uri,
            success(r) {
              try {
                const m = JSON.parse(r.text)
                item.a = m.c ? `${m.a} · ${m.c}` : (m.a || '')
                item.s = m.s || ''
                if (m.k) item.icon = `${ICONS}/${m.k}.png`
                const body = m.b || ''
                item.b = body.length > 120 ? body.substr(0, 120) + '…' : body
              } catch (e) { item.b = `(읽지 못함: ${e} / ${(r.text || '').length}자)` }
              res(item)
            },
            fail(d, c) { item.b = `(파일 읽기 실패 ${c || ''})`; res(item) },
          })
        }))).then((items) => {
          self.list = items
          self.notis = items.length
          self.report()
        })
      },
      fail() { self.list = []; self.notis = 0; self.report() },
      complete() { self.scrollToTop() },
    })
  },

  scrollToTop() {
    const el = this.$element('list')
    if (el) el.scrollTo({ top: 0, behavior: 'smooth' })
  },

  deleteToggle() { if (this.notis) this.deleteOn = !this.deleteOn },

  // 워치에 남은 사진 알림 개수를 폰에 알려줌 (워치 알림 목록의 'N건'에 사용)
  report() {
    try { if (conn) conn.send({ data: { n: this.notis } }) } catch (e) {}
  },

  deleteAll() {
    this.list.forEach((li) => this.removeFile(li))
    this.list = []
    this.notis = 0
    this.deleteOn = false
    this.report()
  },

  deleteOne(li, i) {
    this.removeFile(li)
    this.list.splice(i, 1)
    this.notis = this.list.length
    if (!this.notis) this.deleteOn = false
    this.report()
  },

  removeFile(li) {
    try { file.delete({ uri: li.uri }) } catch (e) {}
  },


  openPopup(li) {
    if (this.deleteOn) return
    router.push({ uri: '/pages/detail', params: { uri: li.uri, arrival: '0' } })
  },

  canVibrate() {
    const s = this.setting
    if (!s.vibe) return false
    if (!s.doNotDisturb) return true
    const from = s.disturbFromT + s.disturbFromM
    const to = s.disturbToT + s.disturbToM
    const now = new Date()
    const t = now.getHours().toString().padStart(2, '0') + now.getMinutes().toString().padStart(2, '0')
    const quiet = from <= to ? (from <= t && t <= to) : (from <= t || t <= to)
    return !quiet
  },

  notifyArrival() {
    if (this.alert.wake) {
      // 화면을 켜서 8초 동안 유지
      try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) {}
      try { brightness.getValue({ success(d) { brightness.setValue({ value: d.value }) } }) } catch (e) {}
      setTimeout(() => { try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {} }, 8000)
    }
    if (this.alert.vibe) {
      try { vibrator.vibrate({ mode: 'long' }) } catch (e) {}
    }
  },

  onDestroy() { app.terminate() },

  decode(b64) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    const look = {}
    for (let i = 0; i < chars.length; i++) look[chars[i]] = i
    look['='] = 0
    const s = b64.replace(/\s/g, '')
    const pad = s.endsWith('==') ? 2 : s.endsWith('=') ? 1 : 0
    const len = Math.floor((s.length * 3) / 4) - pad
    const out = new Uint8Array(len)
    let j = 0
    for (let i = 0; i < s.length; i += 4) {
      const a = look[s[i]], b = look[s[i + 1]], c = look[s[i + 2]] || 0, d = look[s[i + 3]] || 0
      out[j++] = (a << 2) | (b >> 4)
      if (j < len) out[j++] = ((b & 15) << 4) | (c >> 2)
      if (j < len) out[j++] = ((c & 3) << 6) | d
    }
    return out
  },
}
</script>

<style>
  @import '../../common/common.css';
</style>
