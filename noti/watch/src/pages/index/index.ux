<template>
  <div class="main">
    <!-- 도착 화면: 폰이 보낸 알림만 바로 보여줌 (목록·빈 화면을 먼저 보여주지 않음) -->
    <div if="{{ mode === 'arrive' }}" class="arrive" @touchstart="touched">
      <scroll style="flex-direction: column; width: 100%; flex: 1" scroll-y="{{ true }}">
        <image if="{{ cur.img }}" src="{{ cur.img }}" style="width: 100%; margin-top: 28px" @click="openCur" />
        <div if="{{ !cur.img }}" class="tview" @click="openCur">
          <div class="t-row">
            <image if="{{ cur.icon }}" src="{{ cur.icon }}" class="t-icon" />
            <image if="{{ cur.hf }}" src="{{ cur.hf }}" style="width: {{ cur.hw }}px; height: {{ cur.hh }}px" />
            <text if="{{ !cur.hf }}" class="t-app">{{ cur.app }}</text>
          </div>
          <image if="{{ cur.sf }}" src="{{ cur.sf }}" style="width: {{ cur.sw }}px; height: {{ cur.sh }}px; margin-top: 6px" />
          <text if="{{ !cur.sf }}" class="t-snd" style="font-size: {{ alert.fs || 26 }}px">{{ cur.sender }}</text>
          <image if="{{ cur.e }}" src="{{ cur.e }}" style="width: {{ cur.ew }}px; height: {{ cur.eh }}px; margin-top: 6px" />
          <div for="(i, p) in cur.parts" class="seg">
            <text if="{{ !p.img }}" style="width: 100%; font-size: {{ alert.fs || 26 }}px; color: #eeeeee; margin-top: 4px">{{ p.t }}</text>
            <image if="{{ p.img }}" src="{{ p.img }}" style="width: {{ p.w }}px; height: {{ p.h }}px; margin-top: 4px" />
          </div>
          <text if="{{ cur.pending }}" class="t-app" style="margin-top: 10px">사진 받는 중…</text>
        </div>
      </scroll>
      <text class="btn off" @click="arriveOff">끄기</text>
    </div>

    <!-- 목록: 직접 열었을 때 -->
    <div if="{{ mode === 'list' }}" class="arrive">
      <div class="head">
        <div class="head-hit" @click="deleteToggle">
          <text class="head-pill {{ notis ? 'head-pill-on' : '' }}">{{ notis ? (deleteOn ? "X" : "-") : "" }}</text>
        </div>
        <text class="head-title" @click="scrollToTop">알림 {{ notis }}</text>
        <div class="head-hit"></div>
      </div>
      <!-- list = 화면에 보이는 칸만 그림 (사진이 많이 쌓여도 빨리 뜸) -->
      <text class="btn danger" if="{{ deleteOn && notis }}" @click="deleteAll">모두 지우기</text>
      <text class="empty" if="{{ loaded && !notis }}">수신된 알림이 없습니다.</text>
      <list id="list" style="width: 100%; flex: 1" if="{{ notis }}">
        <list-item type="{{ li.kind === 'img' ? 'img' : (li.e ? 'emo' : 'text') }}" for="(i, li) in list" class="card" show="{{ !li.gone }}">
          <text class="btn danger" if="{{ deleteOn }}" @click="deleteOne(li, i)">지우기</text>
          <image if="{{ li.kind === 'img' }}" src="{{ li.uri }}" style="width: 100%" @click="openPopup(li)" />
          <div if="{{ li.kind === 'text' }}" class="tcard" @click="openPopup(li)">
            <div class="t-row">
              <image if="{{ li.icon }}" src="{{ li.icon }}" class="t-icon" />
              <image if="{{ li.hf }}" src="{{ li.hf }}" style="width: {{ li.hw }}px; height: {{ li.hh }}px" />
              <text if="{{ li.hf && li.tm }}" class="t-app" style="margin-left: 8px">{{ li.tm }}</text>
              <text if="{{ !li.hf }}" class="t-app">{{ li.al }}</text>
            </div>
            <image if="{{ li.sf }}" src="{{ li.sf }}" style="width: {{ li.sw }}px; height: {{ li.sh }}px; margin-top: 6px" />
            <text if="{{ !li.sf }}" class="t-snd">{{ li.s }}</text>
            <image if="{{ li.e }}" src="{{ li.e }}" style="width: {{ li.ew }}px; height: {{ li.eh }}px; margin-top: 4px" />
            <text if="{{ !li.e }}" class="t-body">{{ li.b }}</text>
          </div>
        </list-item>
      </list>
      <text if="{{ status }}" style="font-size: 20px; color: #888888; margin-top: 10px">{{ status }}</text>
    </div>
  </div>
</template>

<script>
import app from '@system.app'
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import router from '@system.router'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'

const DIR = 'internal://mass/rw6noti'
const ICONS = 'internal://mass/rw6noti_icons'
// 목록 미리보기 모음 (파일을 하나하나 열지 않고 이것 하나로 목록을 바로 그림)
const META = 'internal://mass/rw6noti_meta'
const INDEX = `${META}/index.json`
let IDX = null // [{ name, kind, uri, a, s, b, icon }] 최신이 앞
let idxWaiters = []
let saving = false
let saveAgain = false
let saveDone = []
const MAX_SAVE = 40
// 앱을 연 뒤 이 시간 안에 폰에서 알림이 오면 목록 없이 그 알림만 보여줌
const WAIT_MS = 700
let conn = null
let waitTimer = null
let screenTimer = null
let inDetailAt = 0 // 읽기 화면을 연 시각 (0 = 안 열림). 읽는 동안엔 앱을 자동으로 닫지 않음
let needS = false // 저장된 설정이 없어 폰에 요청한 상태
// 읽기 화면을 연 지 3분 안일 때만 '읽는 중'으로 봄 (열어 둔 채 화면이 꺼져 계속 남는 경우 대비)
function reading() { return inDetailAt > 0 && Date.now() - inDetailAt < 180000 }
let gotSetting = false // 이번에 폰에서 설정을 받았는지 (받았으면 저장돼 있던 옛 설정으로 덮지 않음)
let userTouched = false // 도착 화면을 만졌으면 5초 뒤 자동으로 닫지 않음
let quietTimer = null // 방해금지 중 받은 뒤 앱 닫기 // 알림이 연달아 오면 마지막 알림 기준 5초
const receiving = {}
const done = {} // 이미 처리한 것 (폰이 같은 글을 여러 번 보내므로)

// 빠른 Base64 해독
const LOOK = new Uint8Array(128)
'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'.split('').forEach((c, i) => { LOOK[c.charCodeAt(0)] = i })

function split(body) {
  const out = []
  let cur = ''
  body.split('\n').forEach((line) => {
    while (line.length > 300) { if (cur) { out.push(cur); cur = '' } out.push(line.substr(0, 300)); line = line.substr(300) }
    if (cur && cur.length + line.length + 1 > 300) { out.push(cur); cur = line } else cur = cur ? `${cur}\n${line}` : line
  })
  if (cur) out.push(cur)
  return out
}

// 글 → 표시 조각 [{t}] / 이모지 조각 포함 [{t} | {img, w, h}]
function toParts(body, sg) {
  if (!sg) return split(body).map((t) => ({ t, img: '', w: 0, h: 0 }))
  const out = []
  sg.forEach((g) => {
    if (g.f) out.push({ t: '', img: g.f, w: g.w, h: g.h })
    else split(g.t || '').forEach((t) => out.push({ t, img: '', w: 0, h: 0 }))
  })
  return out
}

// 받은 시각: 오늘이면 '14:05', 다른 날이면 '11/10 14:05'
function fmtTime(w) {
  if (!w) return ''
  const t = new Date(w), n = new Date()
  const hm = `${t.getHours()}:${String(t.getMinutes()).padStart(2, '0')}`
  const today = t.getFullYear() === n.getFullYear() && t.getMonth() === n.getMonth() && t.getDate() === n.getDate()
  return today ? hm : `${t.getMonth() + 1}/${t.getDate()} ${hm}`
}

function preview(body) { return body.length > 120 ? body.substr(0, 120) + '…' : body }

export default {
  private: {
    mode: 'wait', // wait(검은 화면) → arrive(알림) / list(목록)
    cur: { name: '', img: '', icon: '', app: '', sender: '', parts: [], pending: false, e: '', ew: 0, eh: 0, sf: '', sw: 0, sh: 0, hf: '', hw: 0, hh: 0 },
    list: [],
    notis: 0,
    loaded: false,
    deleteOn: false,
    status: '',
    alert: { vibe: false, wake: false, fs: 26 },
  },

  onInit() {
    const self = this
    gotSetting = false
    needS = false
    inDetailAt = 0
    conn = interconnect.instance()
    conn.onmessage = (msg) => { self.onMsg(msg.data) }
    storage.get({
      key: 'alert',
      success(v) {
        if (gotSetting) return
        try { if (v) self.alert = JSON.parse(v); else self.needSetting() } catch (e) { self.needSetting() }
      },
      fail() { self.needSetting() },
    })
    self.ready()
    // 기다리는 동안 목록을 미리 읽어 둠 → 목록으로 넘어갈 때 바로 그림
    self.idxLoad(() => {})
    // 폰이 연 게 아니라 직접 열었으면 잠시 뒤 목록
    waitTimer = setTimeout(() => { if (self.mode === 'wait') self.showList() }, WAIT_MS)
  },

  onShow() {
    inDetailAt = 0
    this.ready()
    if (this.mode === 'list') this.refreshList()
  },

  // 도착 화면에서 뒤로(스와이프) = 목록으로
  // 도착 화면에서 왼쪽→오른쪽 스와이프 = 워치 메인 화면으로 (알림은 목록에 남음)
  onBackPress() {
    if (this.mode === 'arrive') { app.terminate(); return true }
    return false
  },

  // 폰에 "이 알림 받았어" → 폰이 더 보내지 않음
  ack(name) {
    try { if (conn) conn.send({ data: { ack: name } }) } catch (e) {}
  },

  ready() {
    // 워치 앱 버전도 같이 알려 줌 (폰 앱이 버전이 다르면 알려 주도록)
    let v = ''
    try { v = app.getInfo().versionName || '' } catch (e) {}
    try { if (conn) conn.send({ data: { ready: 1, v } }) } catch (e) {}
  },

  // 워치 앱을 새로 깔아 저장된 설정(진동·화면 켜기·글자 크기)이 없으면 폰에 다시 보내 달라고 함
  needSetting() {
    needS = true
    try { if (conn && !gotSetting) conn.send({ data: { need: 1 } }) } catch (e) {}
  },

  onMsg(d) {
    const self = this
    try {
      const k = d.substr(0, 1)
      if (k === 'S') {
        gotSetting = true
        self.alert = { vibe: d.substr(1, 1) === '1', wake: d.substr(2, 1) === '1', fs: Number(d.substr(3, 2)) || 26, quiet: d.substr(5, 1) === '1',
          wakeMs: Math.max(3000, Math.min(30000, (Number(d.substr(6, 3)) || 50) * 100)) }
        storage.set({ key: 'alert', value: JSON.stringify(self.alert) })
        return
      }
      if (k === 'Q') { self.ready(); return }
      // 순번(2) + 구분(1) + 이름(13) + 데이터.  구분: D/E 글, f/g JPEG, d/e PNG (소문자 d·f = 중간 조각)
      const flag = d.substr(2, 1)
      const kind = (flag === 'D' || flag === 'E') ? 'json' : (flag === 'f' || flag === 'g') ? 'jpg' : 'png'
      const isEnd = flag === 'E' || flag === 'g' || flag === 'e'
      const offset = Number(d.substr(0, 2))
      // 설정 요청이 폰에 안 닿았을 수 있어, 알림이 올 때 한 번 더 요청
      if (offset === 0 && needS && !gotSetting) self.needSetting()
      const name = d.substr(3, 13)
      const key = `${name}.${kind}`
      if (done[key]) { if (isEnd) self.ack(name); return } // 이미 받은 것 → 받았다고 다시 알려줌
      if (offset === 0 || !receiving[key]) receiving[key] = { data: '', next: 0 }
      const r = receiving[key]
      if (offset !== r.next) { delete receiving[key]; return } // 순서 어긋나면 버림 (폰이 다시 보냄)
      r.data += d.substr(16)
      r.next++
      if (!isEnd) return
      delete receiving[key]
      done[key] = true
      self.ack(name)
      if (kind === 'json') self.gotText(name, r.data)
      else self.gotImage(name, kind, r.data)
    } catch (e) {
      self.status = e + ''
    }
  },

  // 글: 받은 내용을 메모리에서 바로 그림 (파일은 뒤에서 저장)
  // 폰이 그려 보낸 그림 조각(이모지만 있는 메시지 e, 이모지 든 줄 sg, 보낸 사람 si, 윗줄 hi)은 파일로 저장한 뒤 한 번에 표시
  gotText(name, json) {
    const self = this
    let m
    try { m = JSON.parse(json) } catch (e) { self.status = `알림 읽기 실패: ${e}`; return }
    if (m.k && m.i) {
      const ib = self.decode(m.i)
      file.mkdir({ uri: ICONS, recursive: true, complete() { file.writeArrayBuffer({ uri: `${ICONS}/${m.k}.png`, buffer: ib }) } })
      delete m.i
    }
    const jobs = []
    const keep = (b64, uri) => { jobs.push({ uri, buf: self.decode(b64) }); return uri }
    if (m.e) { m.ef = keep(m.e, `${META}/${name}.png`); delete m.e }
    if (m.si) { m.sf = keep(m.si, `${META}/${name}_s.png`); delete m.si }
    if (m.hi) { m.hf = keep(m.hi, `${META}/${name}_h.png`); delete m.hi }
    if (m.sg) m.sg.forEach((g, k) => { if (g.i) { g.f = keep(g.i, `${META}/${name}_${k}.png`); delete g.i } })
    const icon = m.k ? `${ICONS}/${m.k}.png` : ''
    const appLine = m.c ? `${m.a} · ${m.c}` : (m.a || '')
    const cur = {
      name, img: '', icon, app: appLine, sender: m.s || '', parts: m.ef ? [] : toParts(m.b || '', m.sg), pending: !!m.p,
      e: m.ef || '', ew: m.ew || 80, eh: m.eh || 80,
      sf: m.sf || '', sw: m.siw || 0, sh: m.sih || 0, hf: m.hf || '', hw: m.hiw || 0, hh: m.hih || 0,
    }
    const showNow = () => {
      // 그림 저장을 기다리는 사이 같은 이름의 사진이 먼저 떴거나, 더 새 알림이 떠 있으면 덮지 않음
      if (done[`${name}.jpg`] || done[`${name}.png`]) return
      if (self.mode === 'arrive' && self.cur.name && self.cur.name > name) return
      self.show(cur); self.notifyArrival()
    }
    if (!jobs.length) showNow()
    else {
      file.mkdir({ uri: META, recursive: true, complete() {
        Promise.all(jobs.map((j) => new Promise((res) => file.writeArrayBuffer({ uri: j.uri, buffer: j.buf, complete: res })))).then(showNow)
      } })
    }
    file.writeText({ uri: `${DIR}/${name}.json`, text: JSON.stringify(m), complete() { self.trim() } })
    self.idxPut({ name, kind: 'text', uri: `${DIR}/${name}.json`, a: appLine, s: m.s || '', b: preview(m.b || ''), icon, w: m.w || 0,
      e: m.ef || '', ew: m.ew || 0, eh: m.eh || 0, sf: m.sf || '', sw: m.siw || 0, sh: m.sih || 0, hf: m.hf || '', hw: m.hiw || 0, hh: m.hih || 0 })
  },

  // 사진: 저장 후 표시. 먼저 온 같은 이름의 글 알림은 지우고 사진으로 바꿈
  gotImage(name, ext, b64) {
    const self = this
    const uri = `${DIR}/${name}.${ext}`
    file.writeArrayBuffer({
      uri,
      buffer: self.decode(b64),
      success() {
        const hadText = done[`${name}.json`]
        try { file.delete({ uri: `${DIR}/${name}.json` }) } catch (e) {}
        if (self.mode !== 'list' || self.cur.name === name) self.show({ name, img: uri, icon: '', app: '', sender: '', parts: [], pending: false, e: '', ew: 0, eh: 0, sf: '', sw: 0, sh: 0, hf: '', hw: 0, hh: 0 })
        if (!hadText) self.notifyArrival()
        else if (self.alert.quiet) self.quietClose() // 사진 저장이 끝난 뒤 닫히도록 다시 맞춤
        else if (self.alert.wake && screenTimer && !userTouched) self.keepOn5s() // 사진이 뜬 뒤 다시 5초
        self.idxPut({ name, kind: 'img', uri, a: '', s: '', b: '', icon: '' })
        if (self.mode === 'list') self.refreshList()
        self.trim()
      },
      fail(e, c) { self.status = `저장 실패: ${c || e}` },
    })
  },

  show(cur) {
    if (waitTimer) { clearTimeout(waitTimer); waitTimer = null }
    this.cur = cur
    this.mode = 'arrive'
  },

  showList() {
    if (waitTimer) { clearTimeout(waitTimer); waitTimer = null }
    this.mode = 'list'
    // 미리 읽어 둔 게 있으면 그대로 바로
    if (IDX) this.applyList(); else this.idxLoad(() => this.applyList())
  },

  // 도착 화면에서 알림을 누르면 읽기 화면으로 ('끄기' = 지우고 앱 닫기, 뒤로 = 도착 화면)
  touched() { userTouched = true },

  openCur() {
    userTouched = true
    const c = this.cur
    if (!c.name) return
    inDetailAt = Date.now()
    router.push({ uri: '/pages/detail', params: { uri: c.img || `${DIR}/${c.name}.json`, arrival: '1' } })
  },

  // 도착 화면의 '끄기' = 이 알림 지우고 앱 닫기
  arriveOff() {
    const self = this
    const n = this.cur.name
    ;['json', 'jpg', 'png'].forEach((e) => { try { file.delete({ uri: `${DIR}/${n}.${e}` }) } catch (x) {} })
    try { conn.send({ data: { del: 1 } }) } catch (x) {}
    // 이 알림의 그림 조각(이모지·보낸 사람·윗줄)도 지운 뒤 닫기
    const close = () => self.idxRemove((e) => e.name === n, () => app.terminate())
    file.list({
      uri: META,
      success(md) {
        md.fileList.forEach((f) => { if (f.uri.replace(/^.*\//, '').indexOf(n) === 0) { try { file.delete({ uri: f.uri }) } catch (x) {} } })
        close()
      },
      fail: close,
    })
  },

  // 오래된 알림 정리
  trim() {
    file.list({
      uri: DIR,
      success(data) {
        const files = data.fileList.sort((a, b) => b.uri.localeCompare(a.uri))
        files.slice(MAX_SAVE).forEach((f) => { try { file.delete({ uri: f.uri }) } catch (e) {} })
        // 남은 알림 이름(13자리) → 그에 딸린 그림 조각만 남기고 나머지 그림 조각은 지움
        const alive = {}
        let newest = ''
        files.slice(0, MAX_SAVE).forEach((f) => { const n = f.uri.replace(/^.*\//, '').substr(0, 13); alive[n] = true; if (n > newest) newest = n })
        file.list({
          uri: META,
          success(md) {
            md.fileList.forEach((f) => {
              const base = f.uri.replace(/^.*\//, '')
              if (!/^\d{13}.*\.png$/.test(base)) return // index.json 등은 그대로
              const n = base.substr(0, 13)
              // 가장 최근 알림보다 새 것은 아직 저장 중일 수 있어 남김
              if (!alive[n] && n < newest) { try { file.delete({ uri: f.uri }) } catch (e) {} }
            })
          },
        })
      },
    })
  },

  // ---- 목록 미리보기 모음 ----
  // 목록 읽기는 한 번에 하나만 (동시에 읽고 쓰다 목록이 비어 보이던 문제 방지)
  idxLoad(cb) {
    const self = this
    if (IDX) { cb(IDX); return }
    idxWaiters.push(cb)
    if (idxWaiters.length > 1) return
    const finish = (list) => { IDX = list; const w = idxWaiters; idxWaiters = []; w.forEach((f) => f(IDX)) }
    file.readText({
      uri: INDEX,
      success(r) {
        let list = null
        try { list = JSON.parse(r.text) } catch (e) { list = null }
        if (!Array.isArray(list)) { self.idxRebuild(finish); return }
        if (list.length) { finish(list); return }
        // 비어 있다는데 알림 파일이 남아 있으면 다시 만듦
        file.list({ uri: DIR, success(d) { if (d.fileList.length) self.idxRebuild(finish); else finish(list) }, fail() { finish(list) } })
      },
      fail() { self.idxRebuild(finish) },
    })
  },
  // 저장도 한 번에 하나씩, 마지막 내용으로
  idxSave(done) {
    if (done) saveDone.push(done)
    if (saving) { saveAgain = true; return }
    saving = true
    const run = () => {
      saveAgain = false
      file.mkdir({ uri: META, recursive: true, complete() {
        file.writeText({ uri: INDEX, text: JSON.stringify(IDX || []), complete() {
          if (saveAgain) { run(); return }
          saving = false
          const d = saveDone; saveDone = []; d.forEach((f) => f())
        } })
      } })
    }
    run()
  },
  idxPut(e) {
    const self = this
    self.idxLoad((list) => {
      IDX = [e].concat(list.filter((x) => x.name !== e.name)).slice(0, MAX_SAVE)
      self.idxSave()
      if (self.mode === 'list') self.applyList()
    })
  },
  idxRemove(pred, done) {
    const self = this
    self.idxLoad((list) => { IDX = list.filter((x) => !pred(x)); self.idxSave(done) })
  },
  // 미리보기 모음이 없을 때(처음 한 번) 파일들을 읽어 만듦
  idxRebuild(cb) {
    const self = this
    file.list({
      uri: DIR,
      success(data) {
        const files = data.fileList.sort((a, b) => b.uri.localeCompare(a.uri))
        const imgs = {}
        files.forEach((f) => { if (f.uri.indexOf('.json') < 0) imgs[f.uri.replace(/\.[a-z]+$/, '')] = true })
        const shown = files.filter((f) => !(f.uri.indexOf('.json') >= 0 && imgs[f.uri.replace(/\.json$/, '')])).slice(0, MAX_SAVE)
        Promise.all(shown.map((f) => new Promise((res) => {
          const name = f.uri.replace(/^.*\//, '').replace(/\.[a-z]+$/, '')
          const e = { name, kind: f.uri.indexOf('.json') >= 0 ? 'text' : 'img', uri: f.uri, a: '', s: '', b: '', icon: '' }
          if (e.kind !== 'text') { res(e); return }
          file.readText({
            uri: f.uri,
            success(r) {
              try {
                const m = JSON.parse(r.text)
                e.a = m.c ? `${m.a} · ${m.c}` : (m.a || ''); e.s = m.s || ''; e.b = preview(m.b || ''); e.w = m.w || 0
                if (m.k) e.icon = `${ICONS}/${m.k}.png`
              } catch (x) {}
              res(e)
            },
            fail() { res(e) },
          })
        }))).then((list) => { IDX = list; self.idxSave(); cb(IDX) })
      },
      fail() { IDX = []; cb(IDX) },
    })
  },

  refreshList() {
    const self = this
    IDX = null // 상세 화면에서 지웠을 수 있으니 다시 읽음 (파일 하나라 빠름)
    self.idxLoad(() => {
      // 새 알림이 없고 지워진 것만 있으면 목록을 새로 그리지 않고 숨기기만 → 보던 위치 그대로
      const now = {}
      IDX.forEach((e) => { now[e.uri] = true })
      const have = {}
      self.list.forEach((li) => { have[li.uri] = true })
      if (self.list.length && IDX.every((e) => have[e.uri])) {
        self.list.forEach((li) => { if (!now[li.uri]) li.gone = true })
        self.notis = IDX.length
        if (!self.notis) self.deleteOn = false
        self.report()
      } else self.applyList()
    })
  },

  applyList() {
    // 목록의 보낸 사람 글자는 24px → 폰이 글자 크기(fs)로 그린 그림도 같은 비율로 줄여 표시
    const r = 24 / (this.alert.fs || 26)
    this.list = (IDX || []).map((e) => ({ uri: e.uri, kind: e.kind, a: e.a, s: e.s, b: e.b, icon: e.icon, e: e.e || '', ew: e.ew || 0, eh: e.eh || 0,
      tm: fmtTime(e.w), al: (e.a || '알림') + (e.w ? ` · ${fmtTime(e.w)}` : ''),
      sf: e.sf || '', sw: Math.round((e.sw || 0) * r), sh: Math.round((e.sh || 0) * r), hf: e.hf || '', hw: e.hw || 0, hh: e.hh || 0, gone: false }))
    this.notis = this.list.length
    this.loaded = true
    this.report()
  },

  scrollToTop() {
    const el = this.$element('list')
    if (el) el.scrollTo({ index: 0 })
  },

  deleteToggle() { if (this.notis) this.deleteOn = !this.deleteOn },

  // 남은 알림 개수를 폰에 알려줌 (워치 알림 목록의 'N건'에 사용)
  report() {
    try { if (conn) conn.send({ data: { n: this.notis } }) } catch (e) {}
  },

  deleteAll() {
    this.list.forEach((li) => this.removeFile(li))
    IDX = []
    this.idxSave()
    this.list = []
    this.notis = 0
    this.deleteOn = false
    this.report()
  },

  // 지운 칸은 목록에서 빼지 않고 숨김 → 목록을 다시 그리지 않아 보던 위치 그대로
  deleteOne(li, i) {
    if (li.gone) return
    this.removeFile(li)
    this.idxRemove((e) => e.uri === li.uri)
    li.gone = true
    this.notis = Math.max(0, this.notis - 1)
    if (!this.notis) this.deleteOn = false
    this.report()
  },

  removeFile(li) {
    try { file.delete({ uri: li.uri }) } catch (e) {}
  },

  openPopup(li) {
    if (this.deleteOn) return
    inDetailAt = Date.now()
    router.push({ uri: '/pages/detail', params: { uri: li.uri, arrival: '0' } })
  },

  notifyArrival() {
    // 폰 방해금지 중: 진동·화면 켜기 없이 저장만 하고 곧 앱을 닫음 (목록을 보고 있을 땐 그대로)
    if (this.alert.quiet) { this.quietClose(); return }
    // 화면 깨우기: 정한 시간(3~30초) 동안 강제로 켜 둔 뒤 시스템에 돌려줌
    if (this.alert.wake) this.keepOn5s()
    if (this.alert.vibe) {
      try { vibrator.vibrate({ mode: 'long' }) } catch (e) {}
    }
  },

  keepOn5s() {
    try { brightness.setKeepScreenOn({ keepScreenOn: true }) } catch (e) {}
    if (screenTimer) clearTimeout(screenTimer)
    userTouched = reading() // 읽기 화면을 보는 중에 새 알림이 와도 읽던 화면을 닫지 않음
    // 정한 시간(폰 앱 설정, 기본 5초) 동안 안 만지면 앱을 닫음 → 화면이 꺼진 뒤 다시 켜면 워치 메인 화면 (알림은 목록에 남음)
    screenTimer = setTimeout(() => {
      screenTimer = null
      this.releaseScreen()
      if (!userTouched && !reading() && this.mode === 'arrive') app.terminate()
    }, this.alert.wakeMs || 5000)
  },

  quietClose() {
    if (this.mode === 'list') return
    if (quietTimer) clearTimeout(quietTimer)
    const wait = this.cur.pending ? 12000 : 1500
    quietTimer = setTimeout(() => { if (this.mode !== 'list' && !reading()) { this.releaseScreen(); app.terminate() } }, wait)
  },

  releaseScreen() { try { brightness.setKeepScreenOn({ keepScreenOn: false }) } catch (e) {} },

  onHide() { userTouched = true; this.releaseScreen() }, // 읽기 화면으로 갔으면 자동으로 닫지 않음

  onDestroy() { this.releaseScreen(); app.terminate() },

  decode(b64) {
    let n = b64.length
    while (n > 0 && b64.charCodeAt(n - 1) === 61) n-- // '=' 제거
    const len = Math.floor((n * 3) / 4)
    const out = new Uint8Array(len)
    let j = 0
    for (let i = 0; i < n; i += 4) {
      const a = LOOK[b64.charCodeAt(i)], b = LOOK[b64.charCodeAt(i + 1)]
      const c = i + 2 < n ? LOOK[b64.charCodeAt(i + 2)] : 0, d = i + 3 < n ? LOOK[b64.charCodeAt(i + 3)] : 0
      out[j++] = (a << 2) | (b >> 4)
      if (j < len) out[j++] = ((b & 15) << 4) | (c >> 2)
      if (j < len) out[j++] = ((c & 3) << 6) | d
    }
    return out
  },
}
</script>

<style>
  @import '../../common/common.css';
  .arrive { width: 100%; flex: 1; flex-direction: column; align-items: center; }
  .tview { width: 100%; flex-direction: column; padding: 28px 24px 16px; }
  .seg { width: 100%; flex-direction: column; }
</style>
