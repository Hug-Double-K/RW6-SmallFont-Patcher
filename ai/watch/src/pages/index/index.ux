<template>
  <div class="main">
    <scroll style="flex-direction: column; width: 100%; flex: 1; align-items: center" scroll-y="{{ true }}">
      <text class="title">RW6 AI 시험</text>
      <text class="log">{{ info }}</text>
      <text class="btn" @click="rec">워치 녹음 시험 (3초)</text>
      <text class="btn" @click="play">녹음 들어 보기</text>
      <text class="log">{{ out }}</text>
    </scroll>
  </div>
</template>

<script>
// 시험용: 이 워치에서 퀵앱이 직접 녹음·재생을 할 수 있는지 확인 (공식 문서에는 REDMI Watch 6 미지원으로 나옴)
import app from '@system.app'
import file from '@system.file'

let record = null
let audio = null
let recErr = ''
let audErr = ''
try { record = require('@system.record'); if (record && record.default) record = record.default } catch (e) { recErr = `${e}` }
try { audio = require('@system.audio'); if (audio && audio.default) audio = audio.default } catch (e) { audErr = `${e}` }

function can(n) { try { return String(app.canIUse(n)) } catch (e) { return 'x' } }

export default {
  private: { info: '', out: '', uri: '' },

  onInit() {
    this.info = `녹음 기능: ${record && record.start ? '있음' : `없음 ${recErr}`}\n`
      + `소리 기능: ${audio ? '있음' : `없음 ${audErr}`}\n`
      + `확인값: ${can('@system.record')} ${can('system.record')} ${can('@system.record.start')} / ${can('@system.audio')}`
  },

  rec() {
    const self = this
    if (!record || !record.start) { self.out = '결과: 이 워치는 앱 녹음을 지원하지 않음'; return }
    self.out = '녹음 중… 워치에 대고 말하세요'
    try {
      record.start({
        duration: 3000, sampleRate: 16000, numberOfChannels: 1, format: 'wav',
        success(d) {
          self.uri = (d && d.uri) || ''
          self.out = `결과: 녹음 성공\n${self.uri}`
          try {
            file.get({ uri: self.uri, success(f) { self.out += `\n크기 ${f.length} bytes` }, fail(e, c) { self.out += `\n파일 확인 실패 ${c}` } })
          } catch (e) {}
        },
        fail(d, code) { self.out = `결과: 녹음 실패 (${code}) ${d}` },
      })
    } catch (e) { self.out = `결과: 녹음 오류 ${e}` }
  },

  play() {
    if (!audio) { this.out = '소리 기능 없음'; return }
    if (!this.uri) { this.out = '먼저 녹음하세요'; return }
    try {
      audio.onerror = () => { this.out += '\n재생 오류' }
      audio.onended = () => { this.out += '\n재생 끝' }
      audio.src = this.uri
      audio.play()
      this.out += '\n재생 중…'
    } catch (e) { this.out = `재생 오류 ${e}` }
  },
}
</script>

<style>
  .main { flex-direction: column; align-items: center; width: 100%; height: 100%; padding: 14px 0px 24px; background-color: black; }
  .title { margin-top: 34px; font-size: 28px; color: #ffffff; }
  .log { width: 86%; margin-top: 10px; font-size: 22px; color: #dddddd; }
  .btn { width: 86%; margin-top: 14px; padding: 16px 10px; border-radius: 30px; background-color: #2f4a8a; text-align: center; font-size: 26px; color: #ffffff; }
</style>
