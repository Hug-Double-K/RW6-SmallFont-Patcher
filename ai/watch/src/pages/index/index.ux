<template>
  <div class="main">
    <scroll style="flex-direction: column; width: 100%; flex: 1; align-items: center" scroll-y="{{ true }}">
      <text class="btn {{ busy ? 'busy' : '' }}" @click="ask">{{ busy ? '진행 중…' : '말하기' }}</text>
      <text class="st" if="{{ status }}">{{ status }}</text>
      <text class="q" if="{{ q }}">나: {{ q }}</text>
      <text class="a" if="{{ a }}">{{ a }}</text>
      <text class="st" if="{{ !a && !status }}">'말하기'를 누르면 전화처럼 연결됩니다. 삑 소리 뒤에 말하세요.</text>
    </scroll>
  </div>
</template>

<script>
// 워치 쪽은 버튼과 글 표시만 맡는다. 듣기·AI·읽어 주기는 폰 앱이 한다 (워치는 앱 녹음을 지원하지 않음).
// 폰 → 워치 메시지: S상태글 / E오류글 / R{"id","q","a"}
import interconnect from '@system.interconnect'
import storage from '@system.storage'

let conn = null
let noReply = null
let giveUp = null
let lastId = 0   // 지금 화면에 보이는 답의 번호
let waitFrom = -1 // 질문을 보낸 시점의 답 번호 (같은 번호의 옛 답이 다시 와도 무시)

export default {
  private: { busy: false, status: '', q: '', a: '' },

  onInit() {
    const self = this
    storage.get({
      key: 'last',
      success(v) {
        try { if (v && !self.a) { const m = JSON.parse(v); self.q = m.q || ''; self.a = m.a || ''; lastId = m.id || 0 } } catch (e) {}
      },
    })
    conn = interconnect.instance()
    conn.onmessage = (msg) => { self.onMsg(msg.data) }
    self.send({ hello: 1 })
  },

  onShow() { this.send({ hello: 1 }) },

  send(data, onFail) {
    try { conn.send({ data, fail(d, code) { if (onFail) onFail(code) } }) } catch (e) { if (onFail) onFail(-1) }
  },

  clearTimers() {
    if (noReply) { clearTimeout(noReply); noReply = null }
    if (giveUp) { clearTimeout(giveUp); giveUp = null }
  },

  ask() {
    const self = this
    if (self.busy) return
    self.busy = true
    self.status = '폰에 요청 중…'
    waitFrom = lastId
    self.clearTimers()
    // 폰이 8초 안에 아무 답도 안 하면 안내
    noReply = setTimeout(() => {
      self.busy = false
      self.status = "폰에서 답이 없어요. 폰의 RW6 AI 앱에서 'AI 대기'를 켜 주세요."
    }, 8000)
    giveUp = setTimeout(() => { self.busy = false }, 120000)
    self.send({ ask: 1 }, (code) => {
      self.clearTimers()
      self.busy = false
      self.status = `폰에 연결 안 됨 (${code}). Mi Fitness 연결과 폰의 RW6 AI 앱을 확인해 주세요.`
    })
  },

  onMsg(d) {
    const k = d.substr(0, 1)
    const body = d.substr(1)
    if (k === 'S') {
      if (noReply) { clearTimeout(noReply); noReply = null }
      this.status = body
      this.busy = true
    } else if (k === 'E') {
      this.clearTimers()
      this.status = body
      this.busy = false
    } else if (k === 'R') {
      try {
        const m = JSON.parse(body)
        if (this.busy && m.id === waitFrom) return // 방금 누르기 전의 옛 답
        this.clearTimers()
        this.q = m.q || ''
        this.a = m.a || ''
        lastId = m.id || 0
        this.status = ''
        this.busy = false
        storage.set({ key: 'last', value: body })
      } catch (e) {}
    }
  },
}
</script>

<style>
  .main { flex-direction: column; align-items: center; width: 100%; height: 100%; padding: 14px 0px 24px; background-color: black; }
  .btn { width: 80%; margin-top: 44px; padding: 22px 10px; border-radius: 40px; background-color: #2f4a8a; text-align: center; font-size: 34px; color: #ffffff; }
  .busy { background-color: #444444; }
  .st { width: 86%; margin-top: 14px; font-size: 22px; color: #aaaaaa; text-align: center; }
  .q { width: 86%; margin-top: 16px; font-size: 22px; color: #9fb7ff; }
  .a { width: 86%; margin-top: 10px; margin-bottom: 30px; font-size: 26px; color: #ffffff; }
</style>
