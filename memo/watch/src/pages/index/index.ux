<template>
  <div class="main">
    <div class="head">
      <text class="head-btn" @click="deleteToggle">{{ count ? (deleteOn ? "X" : "-") : "" }}</text>
      <text class="head-title" @click="toTop">메모 {{ count }}</text>
      <text class="head-btn"></text>
    </div>
    <text class="btn danger" if="{{ deleteOn }}" @click="deleteToggle">지울 메모를 누르세요 (끝내기)</text>
    <text if="{{ status }}" style="font-size: 20px; color: #888888; margin-bottom: 6px">{{ status }}</text>
    <text class="empty" if="{{ !count }}">저장된 메모가 없습니다.</text>
    <list id="list" style="width: 100%; flex: 1" if="{{ count }}">
      <list-item type="memo" for="(i, m) in memos" class="memo" @click="tap(m)">
        <text class="memo-title">{{ m.t }}</text>
        <text class="memo-time">{{ m.d }}</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import router from '@system.router'

const DIR = 'internal://mass/rw6memo'
const INDEX = `${DIR}/index.json`
let conn = null
let saveTimer = null

export default {
  private: {
    memos: [],
    count: 0,
    deleteOn: false,
    status: '',
    index: {},
    receiving: {},
    got: 0,
  },

  onShow() {
    const self = this
    self.load()
    conn = interconnect.instance()
    // F+크기 / C / X+id / NN+d|e+id+JSON조각
    conn.onmessage = async (msg) => {
      try {
        const d = msg.data
        const k = d.substr(0, 1)
        if (k === 'F') { storage.set({ key: 'fontSize', value: d.substr(1) }); return }
        if (k === 'C') { self.clearAll(); return }
        if (k === 'X') { self.removeId(d.substr(1, 13)); return }

        const part = { offset: Number(d.substr(0, 2)), isEnd: d.substr(2, 1) === 'e', id: d.substr(3, 13) }
        if (part.offset === 0 || !self.receiving[part.id]) self.receiving[part.id] = { data: '', next: 0 }
        const r = self.receiving[part.id]
        let wait = 0
        while (part.offset !== r.next) {
          await new Promise((res) => setTimeout(res, 300))
          if (++wait > 300) { delete self.receiving[part.id]; throw new Error('조각 수신 시간 초과') }
        }
        r.data += d.substr(16)
        r.next++
        if (part.isEnd) {
          const text = r.data
          delete self.receiving[part.id]
          const m = JSON.parse(text)
          file.writeText({ uri: `${DIR}/${part.id}.json`, text })
          self.index[part.id] = { t: m.t, ts: m.ts }
          self.got++
          self.status = `받는 중… ${self.got}개`
          self.saveLater()
        }
      } catch (e) {
        self.status = e + ''
      }
    }
  },

  load() {
    const self = this
    file.readText({
      uri: INDEX,
      success(r) { try { self.index = JSON.parse(r.text || '{}') } catch (e) { self.index = {} } self.refresh() },
      fail() { self.index = {}; self.refresh() },
    })
  },

  // 메모가 많이 들어올 때 목록 파일을 매번 쓰지 않도록 1.5초 모아서 저장
  saveLater() {
    const self = this
    if (saveTimer) clearTimeout(saveTimer)
    saveTimer = setTimeout(() => {
      saveTimer = null
      file.writeText({ uri: INDEX, text: JSON.stringify(self.index) })
      self.refresh()
      self.status = `받은 메모 ${self.got}개`
    }, 1500)
  },

  refresh() {
    const list = Object.keys(this.index).map((id) => {
      const m = this.index[id]
      const dt = new Date(m.ts)
      return { id, t: m.t, ts: m.ts, d: `${dt.getFullYear()}/${dt.getMonth() + 1}/${dt.getDate()}` }
    })
    list.sort((a, b) => b.ts - a.ts)
    this.memos = list
    this.count = list.length
    if (!this.count) this.deleteOn = false
  },

  tap(m) {
    if (this.deleteOn) { this.removeId(m.id); return }
    router.push({ uri: '/pages/detail', params: { uri: `${DIR}/${m.id}.json` } })
  },

  toTop() {
    const el = this.$element('list')
    if (el) el.scrollTo({ index: 0 })
  },

  deleteToggle() { if (this.count) this.deleteOn = !this.deleteOn },

  removeId(id) {
    try { file.delete({ uri: `${DIR}/${id}.json` }) } catch (e) {}
    delete this.index[id]
    file.writeText({ uri: INDEX, text: JSON.stringify(this.index) })
    this.refresh()
  },

  clearAll() {
    const self = this
    self.got = 0
    file.rmdir({
      uri: DIR,
      recursive: true,
      complete() {
        file.mkdir({ uri: DIR, recursive: true, complete() {} })
        self.index = {}
        self.refresh()
      },
    })
  },
}
</script>

<style>
  @import '../../common/common.css';
</style>
