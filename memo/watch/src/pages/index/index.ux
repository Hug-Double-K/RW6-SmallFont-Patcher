<template>
  <div class="main">
    <div class="head">
      <text class="head-btn" @click="deleteToggle">{{ count ? (deleteOn ? "X" : "-") : "" }}</text>
      <text class="head-title">메모 {{ count }}</text>
      <text class="head-btn"></text>
    </div>
    <scroll style="flex-direction: column; width: 100%; flex: 1" scroll-y="{{ true }}">
      <text class="empty" if="{{ !count }}">저장된 메모가 없습니다.</text>
      <div class="memo" for="(i, m) in memos" @click="open(m)">
        <text class="btn danger" if="{{ deleteOn }}" @click="remove(m)">지우기</text>
        <text class="memo-title">{{ m.t }}</text>
        <text class="memo-time">{{ m.d }}</text>
      </div>
      <text if="{{ status }}" style="font-size: 20px; color: #888888; margin-top: 10px">{{ status }}</text>
    </scroll>
  </div>
</template>

<script>
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import router from '@system.router'

const DIR = 'internal://mass/rw6memo'
let conn = null

export default {
  private: {
    memos: [],
    count: 0,
    deleteOn: false,
    status: '',
    index: {},
    receiving: {},
  },

  onShow() {
    const self = this
    self.load()
    conn = interconnect.instance()
    // T+id+제목 / NN+d|e+id+데이터 / X+id
    conn.onmessage = async (msg) => {
      try {
        const d = msg.data
        const kind = d.substr(0, 1)
        if (kind === 'T') {
          const id = d.substr(1, 13)
          self.index[id] = { t: d.substr(14), ts: Date.now() }
          self.save()
          return
        }
        if (kind === 'X') {
          self.removeId(d.substr(1, 13))
          return
        }
        const part = { offset: Number(d.substr(0, 2)), isEnd: d.substr(2, 1) === 'e', id: d.substr(3, 13) }
        if (!self.receiving[part.id] || part.offset === 0) self.receiving[part.id] = { data: '', got: [] }
        const r = self.receiving[part.id]
        let wait = 0
        while (part.offset !== 0 && !r.got.includes(part.offset - 1)) {
          await new Promise((res) => setTimeout(res, 500))
          if (++wait > 200) { delete self.receiving[part.id]; throw new Error('조각 수신 시간 초과') }
        }
        r.data += d.substr(16)
        r.got.push(part.offset)
        if (part.isEnd) {
          file.writeArrayBuffer({
            uri: `${DIR}/${part.id}.png`,
            buffer: self.decode(r.data),
            success() {
              const meta = self.index[part.id] || { t: '메모' }
              self.status = `받음: ${meta.t}`
            },
            fail(e) { self.status = `저장 실패: ${e}` },
            complete() { delete self.receiving[part.id] },
          })
        }
      } catch (e) {
        self.status = e + ''
      }
    }
  },

  load() {
    const self = this
    storage.get({
      key: 'memoIndex',
      success(v) { self.index = JSON.parse(v || '{}'); self.refresh() },
      fail() { self.index = {}; self.refresh() },
    })
  },

  save() {
    storage.set({ key: 'memoIndex', value: JSON.stringify(this.index) })
    this.refresh()
  },

  refresh() {
    const list = Object.keys(this.index).map((id) => {
      const m = this.index[id]
      const dt = new Date(m.ts)
      const d = `${dt.getMonth() + 1}/${dt.getDate()} ${String(dt.getHours()).padStart(2, '0')}:${String(dt.getMinutes()).padStart(2, '0')}`
      return { id, t: m.t, ts: m.ts, d }
    })
    list.sort((a, b) => b.ts - a.ts)
    this.memos = list
    this.count = list.length
    if (!this.count) this.deleteOn = false
  },

  open(m) {
    if (this.deleteOn) return
    router.push({ uri: '/pages/detail', params: { uri: `${DIR}/${m.id}.png` } })
  },

  deleteToggle() { if (this.count) this.deleteOn = !this.deleteOn },

  remove(m) { this.removeId(m.id) },

  removeId(id) {
    try { file.delete({ uri: `${DIR}/${id}.png` }) } catch (e) {}
    delete this.index[id]
    this.save()
  },

  decode(b64) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    const look = {}
    for (let i = 0; i < chars.length; i++) look[chars[i]] = i
    const s = b64.replace(/\s/g, '')
    const pad = s.endsWith('==') ? 2 : s.endsWith('=') ? 1 : 0
    const len = Math.floor((s.length * 3) / 4) - pad
    const out = new Uint8Array(len)
    let j = 0
    for (let i = 0; i < s.length; i += 4) {
      const a = look[s[i]], b = look[s[i + 1]], c = look[s[i + 2]] || 0, e = look[s[i + 3]] || 0
      out[j++] = (a << 2) | (b >> 4)
      if (j < len) out[j++] = ((b & 15) << 4) | (c >> 2)
      if (j < len) out[j++] = ((c & 3) << 6) | e
    }
    return out
  },
}
</script>

<style>
  @import '../../common/common.css';
</style>
