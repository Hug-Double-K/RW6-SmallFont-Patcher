<template>
  <div class="main">
    <div class="head">
      <text class="head-btn" @click="deleteToggle">{{ count ? (deleteOn ? "X" : "-") : "" }}</text>
      <text class="head-title" @click="toTop">메모 {{ count }}</text>
      <text class="head-btn"></text>
    </div>
    <text class="btn danger" if="{{ deleteOn }}" @click="deleteToggle">지울 메모를 누르세요 (끝내기)</text>
    <text if="{{ status }}" style="font-size: 20px; color: #888888; margin-bottom: 6px">{{ status }}</text>
    <text class="empty" if="{{ !count }}">저장된 메모가 없습니다.</text>
    <list id="list" style="width: 100%; flex: 1" if="{{ count }}" @scrollbottom="more">
      <list-item type="memo" for="(i, m) in memos" class="memo" @click="tap(m)">
        <text class="memo-title">{{ m.t }}</text>
        <text class="memo-time">{{ m.d }}</text>
      </list-item>
      <list-item type="more" if="{{ shown < count }}" class="memo" @click="more">
        <text class="memo-title" style="text-align: center">더 보기 ({{ count - shown }}개 남음)</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import file from '@system.file'
import storage from '@system.storage'
import interconnect from '@system.interconnect'
import router from '@system.router'
import brightness from '@system.brightness'

const DIR = 'internal://mass/rw6memo'
const INDEX = `${DIR}/index.json`
const PAGE = 40
// 목록 원본은 화면 데이터(반응형) 밖에 둬서 메모가 많아도 가볍게
let INDEXMAP = {}
let ALL = []
let conn = null
let chain = Promise.resolve()
let saveTimer = null
let recv = null

// 콜백형 API를 기다릴 수 있게
function call(fn, args) {
  return new Promise((res) => {
    try {
      fn(Object.assign({}, args, {
        success: (d) => res({ ok: true, d }),
        fail: (d, c) => res({ ok: false, d: `${d} ${c || ''}` }),
      }))
    } catch (e) { res({ ok: false, d: e + '' }) }
  })
}

export default {
  private: {
    memos: [],
    count: 0,
    shown: PAGE,
    deleteOn: false,
    status: '',
    got: 0,
    total: 0,
  },

  // 처음 한 번만 (상세 화면에서 돌아올 때마다 다시 읽지 않음)
  onInit() {
    const self = this
    self.load()
    conn = interconnect.instance()
    // 메시지는 도착 순서대로 하나씩 처리
    conn.onmessage = (msg) => {
      const d = msg.data
      chain = chain.then(() => self.handle(d)).catch((e) => { self.status = e + '' })
    }
  },

  async handle(d) {
    const k = d.substr(0, 1)
    if (k === 'F') { storage.set({ key: 'fontSize', value: d.substr(1) }); return }
    if (k === 'X') { this.removeId(d.substr(1, 13)); return }
    if (k === 'C') {
      this.total = Number(d.substr(1)) || 0
      this.got = 0
      recv = null
      if (this.total) this.keepOn(true)
      await call(file.rmdir, { uri: DIR, recursive: true })
      await call(file.mkdir, { uri: DIR, recursive: true })
      INDEXMAP = {}
      this.saveNow()
      this.status = this.total ? `받는 중… 0 / ${this.total}` : ''
      return
    }
    if (k === 'E') {
      this.saveNow()
      this.keepOn(false)
      this.status = this.got < this.total ? `받은 메모 ${this.got} / ${this.total}개 (일부 빠짐)` : `받은 메모 ${this.got}개`
      return
    }
    if (k !== 'P') return

    const idx = Number(d.substr(1, 3))
    const end = d.substr(4, 1) === 'e'
    const name = d.substr(5, 13)
    if (idx === 0 || !recv || recv.name !== name) recv = { name, data: '', next: 0 }
    if (idx !== recv.next) { recv = null; return } // 순서가 어긋나면 버림 (폰이 묶음 처음부터 다시 보냄)
    recv.data += d.substr(18)
    recv.next++
    if (!end) return

    const text = recv.data
    recv = null
    const arr = JSON.parse(text)
    const uri = `${DIR}/${name}.json`
    let r = await call(file.writeText, { uri, text })
    if (!r.ok) {
      await call(file.mkdir, { uri: DIR, recursive: true })
      r = await call(file.writeText, { uri, text })
    }
    if (!r.ok) throw new Error('저장 실패: ' + r.d)
    arr.forEach((m) => { INDEXMAP[m.i] = { t: m.t, ts: m.ts, b: name } })
    this.got += arr.length
    this.status = this.total ? `받는 중… ${this.got} / ${this.total}` : `받은 메모 ${arr.length}개`
    this.saveLater()
  },

  keepOn(on) {
    try { brightness.setKeepScreenOn({ keepScreenOn: on }) } catch (e) {}
  },

  load() {
    const self = this
    file.readText({
      uri: INDEX,
      success(r) { try { INDEXMAP = JSON.parse(r.text || '{}') } catch (e) { INDEXMAP = {} } self.refresh() },
      fail() { INDEXMAP = {}; self.refresh() },
    })
  },

  // 많이 받는 중에는 목록 파일을 매번 쓰지 않도록 모아서 저장
  saveLater() {
    if (saveTimer) clearTimeout(saveTimer)
    saveTimer = setTimeout(() => this.saveNow(), 2000)
  },

  saveNow() {
    if (saveTimer) { clearTimeout(saveTimer); saveTimer = null }
    file.writeText({ uri: INDEX, text: JSON.stringify(INDEXMAP) })
    this.refresh()
  },

  refresh() {
    ALL = Object.keys(INDEXMAP).map((id) => {
      const m = INDEXMAP[id]
      return { id, t: m.t, ts: m.ts, b: m.b || '' }
    })
    ALL.sort((a, b) => b.ts - a.ts)
    this.count = ALL.length
    this.shown = PAGE
    this.memos = this.page(0, PAGE)
    if (!this.count) this.deleteOn = false
  },

  page(from, to) {
    return ALL.slice(from, to).map((m) => {
      const dt = new Date(m.ts)
      return { id: m.id, t: m.t, b: m.b, d: `${dt.getFullYear()}/${dt.getMonth() + 1}/${dt.getDate()}` }
    })
  },

  // 끝까지 내리면 다음 40개
  more() {
    if (this.shown >= ALL.length) return
    const next = this.page(this.shown, this.shown + PAGE)
    this.shown += PAGE
    this.memos = this.memos.concat(next)
  },

  tap(m) {
    if (this.deleteOn) { this.removeId(m.id); return }
    router.push({ uri: '/pages/detail', params: { b: m.b, id: m.id } })
  },

  toTop() {
    const el = this.$element('list')
    if (el) el.scrollTo({ index: 0 })
  },

  deleteToggle() { if (this.count) this.deleteOn = !this.deleteOn },

  removeId(id) {
    delete INDEXMAP[id]
    if (id.length === 13) { try { file.delete({ uri: `${DIR}/${id}.json` }) } catch (e) {} }
    this.saveNow()
  },

  onDestroy() { this.keepOn(false) },
}
</script>

<style>
  @import '../../common/common.css';
</style>
