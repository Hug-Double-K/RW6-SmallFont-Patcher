<template>
  <div class="main">
    <!-- 보기 전용. 뒤로 = 오른쪽으로 스와이프 -->
    <scroll style="flex-direction: column; width: 100%; flex: 1; padding: 0 14px" scroll-y="{{ true }}">
      <text style="font-size: {{ fs * 1.1 }}px; color: #ffffff; font-weight: bold; margin-bottom: 10px">{{ title }}</text>
      <text style="font-size: {{ fs }}px; color: #e6e6e6; line-height: {{ fs * 1.35 }}px">{{ body }}</text>
      <text style="font-size: 18px; color: #777777; margin-top: 16px; margin-bottom: 20px">{{ date }}</text>
    </scroll>
  </div>
</template>

<script>
import file from '@system.file'
import storage from '@system.storage'

export default {
  protected: { uri: '' },
  private: { title: '', body: '', date: '', fs: 24 },
  onShow() {
    const self = this
    storage.get({ key: 'fontSize', success(v) { const n = Number(v); if (n > 0) self.fs = n } })
    file.readText({
      uri: self.uri,
      success(r) {
        try {
          const m = JSON.parse(r.text)
          self.title = m.t
          self.body = m.b || ''
          const dt = new Date(m.ts)
          self.date = `${dt.getFullYear()}/${dt.getMonth() + 1}/${dt.getDate()} 수정`
        } catch (e) { self.body = '메모를 읽지 못했어요' }
      },
      fail() { self.body = '메모를 찾지 못했어요' },
    })
  },
}
</script>

<style>
  @import '../../common/common.css';
</style>
